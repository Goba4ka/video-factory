{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.video-factory/contracts/voice_profile_approval.schema.json",
  "title": "VoiceProfileApproval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "provider",
    "reference_id",
    "state",
    "languages",
    "eligible_lanes",
    "rights_status",
    "rights_review",
    "golden_sample",
    "quality_review"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "profile_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{2,127}$"
    },
    "provider": {"const": "fish_audio"},
    "reference_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{2,127}$"
    },
    "provider_title": {"type": "string", "minLength": 1, "maxLength": 200},
    "state": {"const": "approved"},
    "languages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$"}
    },
    "eligible_lanes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": ["war_history", "celebrity_news", "chinese_medicine", "health"]
      }
    },
    "rights_status": {
      "enum": ["approved_owned_voice", "approved_licensed_voice"]
    },
    "rights_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "basis", "evidence", "reviewed_by", "reviewed_at"],
      "properties": {
        "decision": {"const": "approved"},
        "basis": {"enum": ["voice_owner_confirmation", "commercial_license"]},
        "evidence": {"type": "string", "minLength": 10, "maxLength": 2000},
        "reviewed_by": {"type": "string", "minLength": 2, "maxLength": 128},
        "reviewed_at": {"type": "string", "format": "date-time"}
      }
    },
    "golden_sample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes", "immutable"],
      "properties": {
        "path": {"type": "string", "minLength": 5, "maxLength": 1024},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 44},
        "immutable": {"const": true}
      }
    },
    "quality_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "reviewed_by",
        "reviewed_at",
        "timbre_approved",
        "diction_approved",
        "pacing_approved",
        "emotional_range_approved",
        "russian_pronunciation_approved",
        "note"
      ],
      "properties": {
        "decision": {"const": "approved"},
        "reviewed_by": {"type": "string", "minLength": 2, "maxLength": 128},
        "reviewed_at": {"type": "string", "format": "date-time"},
        "timbre_approved": {"const": true},
        "diction_approved": {"const": true},
        "pacing_approved": {"const": true},
        "emotional_range_approved": {"const": true},
        "russian_pronunciation_approved": {"const": true},
        "note": {"type": "string", "minLength": 10, "maxLength": 2000}
      }
    }
  }
}
