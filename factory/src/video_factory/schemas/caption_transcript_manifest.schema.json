{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.video-factory/contracts/caption_transcript_manifest.schema.json",
  "title": "CaptionTranscriptManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "job_id", "lane_id", "render_id", "render_sha256",
    "status", "warnings", "observer", "evidence", "word_count", "created_at"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "job_id": {"type": "string", "minLength": 6},
    "lane_id": {
      "enum": ["war_history", "celebrity_news", "motivation", "chinese_medicine", "health"]
    },
    "render_id": {"type": "string", "minLength": 6},
    "render_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "status": {"type": "string", "const": "completed"},
    "warnings": {"type": "array", "maxItems": 0},
    "observer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable_sha256", "engine_name", "engine_version", "run_id"],
      "properties": {
        "executable_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "engine_name": {"type": "string", "minLength": 1},
        "engine_version": {"type": "string", "minLength": 1},
        "run_id": {"type": "string", "minLength": 6}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "word_count": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
