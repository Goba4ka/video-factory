{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.video-factory/contracts/render_project_manifest.schema.json",
  "title": "ProjectManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "job_id",
    "idea_id",
    "lane_id",
    "project_root",
    "entrypoint",
    "composition",
    "bindings",
    "assets",
    "files",
    "project_tree_sha256",
    "preview"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "project_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{5,127}$"},
    "job_id": {"type": "string", "minLength": 6},
    "idea_id": {"type": "string", "minLength": 6},
    "lane_id": {
      "enum": ["war_history", "celebrity_news", "motivation", "chinese_medicine", "health"]
    },
    "project_root": {"type": "string", "minLength": 1},
    "entrypoint": {"const": "index.html"},
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["composition_id", "width", "height", "fps", "duration_seconds"],
      "properties": {
        "composition_id": {"const": "main"},
        "width": {"const": 1080},
        "height": {"const": 1920},
        "fps": {"const": 30},
        "duration_seconds": {"type": "number", "minimum": 15, "maximum": 180}
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shotlist", "script_package", "frozen_media_manifest",
        "authoritative_audio", "program_audio"
      ],
      "properties": {
        "shotlist": {
          "type": "object",
          "additionalProperties": false,
          "required": ["contract", "schema_version", "idea_id", "sha256"],
          "properties": {
            "contract": {"const": "shotlist"},
            "schema_version": {"const": "1.0.0"},
            "idea_id": {"type": "string", "minLength": 6},
            "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          }
        },
        "script_package": {
          "type": "object",
          "additionalProperties": false,
          "required": ["contract", "schema_version", "idea_id", "job_id", "sha256"],
          "properties": {
            "contract": {"const": "script_package"},
            "schema_version": {"const": "1.0.0"},
            "idea_id": {"type": "string", "minLength": 6},
            "job_id": {"type": "string", "minLength": 6},
            "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          }
        },
        "frozen_media_manifest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["contract", "schema_version", "idea_id", "job_id", "sha256"],
          "properties": {
            "contract": {"const": "frozen_media_manifest"},
            "schema_version": {"const": "1.0.0"},
            "idea_id": {"type": "string", "minLength": 6},
            "job_id": {"type": "string", "minLength": 6},
            "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          }
        },
        "authoritative_audio": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contract", "schema_version", "job_id", "sha256",
            "audio_sha256"
          ],
          "properties": {
            "contract": {"enum": ["voice_manifest", "source_audio_manifest"]},
            "schema_version": {"enum": ["1.0.0", "1.1.0"]},
            "job_id": {"type": "string", "minLength": 6},
            "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "audio_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          }
        },
        "program_audio": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contract", "schema_version", "job_id", "idea_id", "lane_id",
            "sha256", "audio_sha256", "project_path", "size_bytes"
          ],
          "properties": {
            "contract": {"const": "program_audio_manifest"},
            "schema_version": {"const": "1.0.0"},
            "job_id": {"type": "string", "minLength": 6},
            "idea_id": {"type": "string", "minLength": 6},
            "lane_id": {
              "enum": ["war_history", "celebrity_news", "motivation", "chinese_medicine", "health"]
            },
            "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "audio_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "project_path": {"const": "assets/audio/program_mix.wav"},
            "size_bytes": {"type": "integer", "minimum": 44}
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_id", "frozen_path", "project_path", "sha256", "size_bytes",
          "content_type", "shot_ids"
        ],
        "properties": {
          "asset_id": {"type": "string", "minLength": 3},
          "frozen_path": {"type": "string", "minLength": 1},
          "project_path": {"type": "string", "pattern": "^assets/media/"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 1},
          "content_type": {"type": "string", "pattern": "^video/"},
          "shot_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 3}
          }
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size_bytes"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 1}
        }
      }
    },
    "project_tree_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "render_authorized", "human_approval_required"],
      "properties": {
        "status": {"const": "ready_for_human_review"},
        "render_authorized": {"const": false},
        "human_approval_required": {"const": true}
      }
    }
  }
}
