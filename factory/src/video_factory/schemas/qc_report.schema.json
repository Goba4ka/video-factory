{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.video-factory/contracts/qc_report.schema.json",
  "title": "QCReport",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "render_id", "technical", "checks", "decision"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "job_id": {"type": "string", "minLength": 6},
    "render_id": {"type": "string", "minLength": 6},
    "technical": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audio_sample_rate_hz"],
      "properties": {
        "audio_sample_rate_hz": {"const": 48000}
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "category", "status", "evidence"],
        "properties": {
          "check_id": {"type": "string", "minLength": 3},
          "category": {
            "enum": ["technical", "audio", "captions", "facts", "rights", "dedup", "policy", "visual"]
          },
          "status": {"enum": ["pass", "warn", "fail", "not_run"]},
          "evidence": {"type": "string", "minLength": 1},
          "artifact": {"type": ["string", "null"]}
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "needs_human_review", "blocking_check_ids", "review_notes"],
      "properties": {
        "passed": {"type": "boolean"},
        "needs_human_review": {"type": "boolean"},
        "blocking_check_ids": {"type": "array", "items": {"type": "string"}},
        "review_notes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "created_at": {"type": "string", "format": "date-time"}
  }
}
