{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.video-factory/contracts/dedup_corpus_snapshot.schema.json",
  "title": "DedupCorpusSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "snapshot_id", "generated_at", "algorithm", "sample_interval_seconds", "entries"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "snapshot_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "algorithm": {"const": "dhash-64-v1"},
    "sample_interval_seconds": {"type": "number", "minimum": 0.1, "maximum": 10},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["comparison_id", "job_id", "render_id", "render_sha256", "frame_hashes"],
        "properties": {
          "comparison_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
          "job_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
          "render_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
          "render_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "frame_hashes": {
            "type": "array",
            "minItems": 8,
            "items": {"type": "string", "pattern": "^[a-f0-9]{16}$"}
          }
        }
      }
    }
  }
}
