{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.video-factory/contracts/word_transcript_evidence.schema.json",
  "title": "WordTranscriptEvidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "job_id", "render_id", "render_sha256", "status",
    "warnings", "language", "duration_seconds", "engine", "completed_at", "words"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "job_id": {"type": "string", "minLength": 6},
    "render_id": {"type": "string", "minLength": 6},
    "render_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "status": {"enum": ["completed", "warn", "failed", "not_run"]},
    "warnings": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "language": {"type": "string", "const": "ru"},
    "duration_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 180},
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "run_id"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "run_id": {"type": "string", "minLength": 6}
      }
    },
    "completed_at": {"type": "string", "format": "date-time"},
    "words": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "start_seconds", "end_seconds", "confidence"],
        "properties": {
          "text": {"type": "string", "minLength": 1, "maxLength": 80},
          "start_seconds": {"type": "number", "minimum": 0, "maximum": 180},
          "end_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 180},
          "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
        }
      }
    }
  }
}
