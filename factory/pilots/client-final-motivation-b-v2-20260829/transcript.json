    { "start": 0.00, "end": 0.37, "text": "Строгий." },
    { "start": 0.38, "end": 1.14, "text": "Но строгий" },
    { "start": 1.14, "end": 1.60, "text": "педагог" },
    { "start": 1.60, "end": 2.62, "text": "в профессии." },
    { "start": 2.86, "end": 3.38, "text": "В жизни" },
    { "start": 3.38, "end": 4.00, "text": "я друг." },
    { "start": 5.32, "end": 6.14, "text": "Я первый человек," },
    { "start": 6.28, "end": 7.00, "text": "кто их поймёт," },
    { "start": 7.12, "end": 7.58, "text": "потому что я" },
    { "start": 7.58, "end": 8.50, "text": "их обожаю." },
    { "start": 9.18, "end": 9.86, "text": "Возлюби ближнего" },
    { "start": 9.86, "end": 10.68, "text": "своего," },
    { "start": 10.88, "end": 11.26, "text": "как себя" },
    { "start": 11.26, "end": 11.60, "text": "самого." },
    { "start": 11.96, "end": 12.18, "text": "Себя" },
    { "start": 12.18, "end": 12.56, "text": "сначала" },
    { "start": 12.56, "end": 13.24, "text": "полюби." },
    { "start": 13.50, "end": 13.98, "text": "Научись" },
    { "start": 13.98, "end": 14.78, "text": "уважать себя." },
    { "start": 15.10, "end": 15.62, "text": "Ты сможешь" },
    { "start": 15.62, "end": 16.26, "text": "тогда уважать" },
    { "start": 16.26, "end": 17.10, "text": "другого человека." },
    { "start": 17.52, "end": 18.08, "text": "Это очень" },
    { "start": 18.08, "end": 19.52, "text": "сложные вещи." },
    { "start": 19.92, "end": 20.76, "text": "Но в" },
    { "start": 20.76, "end": 21.58, "text": "воспитании," },
    { "start": 21.92, "end": 22.78, "text": "когда тебя" },
    { "start": 22.78, "end": 23.48, "text": "приучают" },
    { "start": 23.48, "end": 23.84, "text": "к тому," },
    { "start": 23.90, "end": 24.32, "text": "что тебя" },
    { "start": 24.32, "end": 25.66, "text": "всегда услышат," },
    { "start": 26.38, "end": 27.32, "text": "но ты обязан" },
    { "start": 27.32, "end": 28.18, "text": "ещё услышать" },
    { "start": 28.18, "end": 29.10, "text": "другого." },
    { "start": 29.10, "end": 29.82, "text": "Вот" },
    { "start": 29.82, "end": 30.36, "text": "это очень" },
