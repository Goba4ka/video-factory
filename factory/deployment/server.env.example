# Non-secret runtime configuration. Install as /etc/video-factory/runtime.env.
VIDEO_FACTORY_RUNTIME_ROOT=/var/lib/video-factory
# Keep SQLite and its transient WAL/SHM siblings in their own writable scope.
# Provider workers can therefore update queue leases without write access to
# renders, rights evidence, voice files, or final-review bundles.
VIDEO_FACTORY_DB=/var/lib/video-factory/queue/factory.sqlite3
FISH_USAGE_DB=/var/lib/video-factory/fish_audio_usage.sqlite3
VIDEO_FACTORY_VOICE_APPROVAL_ROOT=/var/lib/video-factory/voice_approvals
VIDEO_FACTORY_VOICE_OUTPUT_ROOT=/var/lib/video-factory/voices
VIDEO_FACTORY_WORKSPACE=/opt/video-factory/current
VIDEO_FACTORY_CODEX_WORKSPACE=/var/lib/video-factory/codex_workspace
VIDEO_FACTORY_AGENT_OUTPUT_ROOT=/var/lib/video-factory/agent_outputs
VIDEO_FACTORY_FFMPEG=/usr/bin/ffmpeg
VIDEO_FACTORY_FFPROBE=/usr/bin/ffprobe
VIDEO_FACTORY_NODE=/usr/bin/node
VIDEO_FACTORY_FFMPEG_THREADS=6
HYPERFRAMES_WORKERS=1
HYPERFRAMES_VERSION=0.8.17
HYPERFRAMES_BIN=/opt/video-factory/toolchain/node_modules/.bin/hyperframes
HYPERFRAMES_GPU_ENCODING=0
VIDEO_FACTORY_RENDER_LEASE_SECONDS=7200

# Production editorial workers are pinned and fail closed if either value drifts.
VIDEO_FACTORY_CODEX=/opt/video-factory/toolchain/node_modules/.bin/codex
VIDEO_FACTORY_CODEX_VERSION=0.151.0
VIDEO_FACTORY_CODEX_MODEL=gpt-5.4
VIDEO_FACTORY_CODEX_TIMEOUT=1800
VIDEO_FACTORY_WORKER_LEASE_SECONDS=900
VIDEO_FACTORY_WORKER_HEARTBEAT_SECONDS=300
VIDEO_FACTORY_WORKER_POLL_SECONDS=2

# Deterministic media/compiler/render/QC workers. Render and frame/media-heavy
# QC roles share one advisory GPU-heavy lock and acquire it before queue claim.
VIDEO_FACTORY_RUNTIME_HANDLER_TIMEOUT=7200
VIDEO_FACTORY_RUNTIME_WORKER_LEASE_SECONDS=7500
VIDEO_FACTORY_RUNTIME_WORKER_HEARTBEAT_SECONDS=300
VIDEO_FACTORY_MEDIA_INPUT_ROOT=/var/lib/video-factory/media_inputs
VIDEO_FACTORY_MEDIA_OUTPUT_ROOT=/var/lib/video-factory/frozen_media
VIDEO_FACTORY_MEDIA_MAX_BYTES=2147483648
VIDEO_FACTORY_MEDIA_TIMEOUT_SECONDS=600
# After the rights task has approved the exact direct download URL, the media
# handler may fetch those bytes through its SSRF/redirect/size gates.
VIDEO_FACTORY_MEDIA_ALLOW_RIGHTS_DOWNLOADS=true
VIDEO_FACTORY_SOURCE_AUDIO_OUTPUT_ROOT=/var/lib/video-factory/source_audio
VIDEO_FACTORY_SOURCE_AUDIO_TIMEOUT_SECONDS=600
VIDEO_FACTORY_BGM_OUTPUT_ROOT=/var/lib/video-factory/bgm
VIDEO_FACTORY_RIGHTS_EVIDENCE_ROOT=/srv/video-factory/artifacts/rights-evidence
VIDEO_FACTORY_BGM_TIMEOUT_SECONDS=600
VIDEO_FACTORY_PROGRAM_AUDIO_OUTPUT_ROOT=/var/lib/video-factory/program_audio
VIDEO_FACTORY_AUDIO_MIX_TIMEOUT_SECONDS=1200
VIDEO_FACTORY_HYPERFRAMES_PROJECT_ROOT=/var/lib/video-factory/hyperframes_projects
VIDEO_FACTORY_GSAP_PATH=/opt/video-factory/toolchain/node_modules/gsap/dist/gsap.min.js
VIDEO_FACTORY_RENDER_OUTPUT_ROOT=/var/lib/video-factory/renders
VIDEO_FACTORY_RENDER_TIMEOUT_SECONDS=7200
VIDEO_FACTORY_RENDER_CRF=16
VIDEO_FACTORY_QC_EVIDENCE_ROOT=/var/lib/video-factory/qc_evidence
VIDEO_FACTORY_QC_CACHE_ROOT=/var/lib/video-factory/qc_cache
# Trusted local observer adapters. These are executable files, not shell
# fragments; handlers invoke them with shell=false and JSON stdin/stdout.
VIDEO_FACTORY_CAPTION_OBSERVER_EXECUTABLE=/opt/video-factory/caption-observer/bin/caption-observer
VIDEO_FACTORY_CAPTION_OBSERVER_TIMEOUT_SECONDS=600
# Pre-stage a converted Faster-Whisper model. The worker never downloads it.
VIDEO_FACTORY_CAPTION_MODEL_PATH=/srv/video-factory/models/faster-whisper-large-v3-ct2
# Fill with `caption-observer --fingerprint-model $VIDEO_FACTORY_CAPTION_MODEL_PATH`.
VIDEO_FACTORY_CAPTION_MODEL_SHA256=
VIDEO_FACTORY_CAPTION_DEVICE=cuda
VIDEO_FACTORY_CAPTION_DEVICE_INDEX=0
VIDEO_FACTORY_CAPTION_COMPUTE_TYPE=float16
VIDEO_FACTORY_CAPTION_CPU_THREADS=0
VIDEO_FACTORY_CAPTION_BEAM_SIZE=5
VIDEO_FACTORY_CAPTION_LANGUAGE_PROBABILITY_MIN=0.65
VIDEO_FACTORY_DEDUP_CORPUS_SNAPSHOT=/srv/video-factory/artifacts/dedup/corpus.json
# Bundled offline adapter. Production defaults to the stronger YuNet backend;
# provision this ONNX file out of band and pin its exact approved bytes.
VIDEO_FACTORY_FACE_OBSERVER=/opt/video-factory/current/.venv/bin/video-factory-face-observer
VIDEO_FACTORY_FACE_ENGINE=yunet
VIDEO_FACTORY_FACE_MODEL_PATH=/srv/video-factory/models/face_detection_yunet_2023mar.onnx
VIDEO_FACTORY_FACE_MODEL_SHA256=REPLACE_WITH_APPROVED_LOWERCASE_SHA256
VIDEO_FACTORY_REVIEW_OUTBOX_ROOT=/var/lib/video-factory/review_outbox
VIDEO_FACTORY_REVIEW_RECONCILE_LIMIT=100
VIDEO_FACTORY_PROVIDER_HANDLER_TIMEOUT=120
VIDEO_FACTORY_PEXELS_CACHE_ROOT=/var/lib/video-factory/discovery/pexels
VIDEO_FACTORY_PEXELS_CACHE_TTL_SECONDS=86400
VIDEO_FACTORY_PEXELS_REQUESTS_PER_HOUR=180
VIDEO_FACTORY_PEXELS_TIMEOUT_SECONDS=20
VIDEO_FACTORY_PEXELS_MAX_RESPONSE_BYTES=8388608
VIDEO_FACTORY_PEXELS_MINIMUM_WIDTH=720
VIDEO_FACTORY_PEXELS_MINIMUM_HEIGHT=1280

# The voice systemd unit overrides this with its private %d credential path.
# For a manual one-shot, set a process-local mounted path. Never put the key
# itself in this environment file or repository.
FISH_API_KEY_FILE=
FISH_MODEL=s2.1-pro
FISH_SPEED=1.0
FISH_TEMPERATURE=0.7
FISH_TOP_P=0.7
FISH_TIMEOUT_SECONDS=180

# Optional reference ID is not a secret, but keep it outside versioned jobs so
# a voice change is explicit at deployment time.
FISH_REFERENCE_ID=
