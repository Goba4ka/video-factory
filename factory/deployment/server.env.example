# Non-secret runtime configuration. Install as /etc/video-factory/runtime.env.
VIDEO_FACTORY_RUNTIME_ROOT=/var/lib/video-factory
VIDEO_FACTORY_DB=/var/lib/video-factory/factory.sqlite3
FISH_USAGE_DB=/var/lib/video-factory/fish_audio_usage.sqlite3
VIDEO_FACTORY_VOICE_APPROVAL_ROOT=/var/lib/video-factory/voice_approvals
VIDEO_FACTORY_VOICE_OUTPUT_ROOT=/var/lib/video-factory/voices
VIDEO_FACTORY_WORKSPACE=/opt/video-factory/current
VIDEO_FACTORY_CODEX_WORKSPACE=/var/lib/video-factory/codex_workspace
VIDEO_FACTORY_AGENT_OUTPUT_ROOT=/var/lib/video-factory/agent_outputs
VIDEO_FACTORY_FFMPEG=/usr/bin/ffmpeg
VIDEO_FACTORY_FFPROBE=/usr/bin/ffprobe
VIDEO_FACTORY_NODE=/usr/bin/node
VIDEO_FACTORY_FFMPEG_THREADS=6
HYPERFRAMES_WORKERS=1
HYPERFRAMES_VERSION=0.8.17
HYPERFRAMES_BIN=/opt/video-factory/toolchain/node_modules/.bin/hyperframes
HYPERFRAMES_GPU_ENCODING=0
VIDEO_FACTORY_RENDER_LEASE_SECONDS=7200

# Production editorial workers are pinned and fail closed if either value drifts.
VIDEO_FACTORY_CODEX=/opt/video-factory/toolchain/node_modules/.bin/codex
VIDEO_FACTORY_CODEX_VERSION=0.151.0
VIDEO_FACTORY_CODEX_MODEL=gpt-5.4
VIDEO_FACTORY_CODEX_TIMEOUT=1800
VIDEO_FACTORY_WORKER_LEASE_SECONDS=900
VIDEO_FACTORY_WORKER_HEARTBEAT_SECONDS=300
VIDEO_FACTORY_WORKER_POLL_SECONDS=2

# The voice systemd unit overrides this with its private %d credential path.
# For a manual one-shot, set a process-local mounted path. Never put the key
# itself in this environment file or repository.
FISH_API_KEY_FILE=
FISH_MODEL=s2.1-pro
FISH_SPEED=1.0
FISH_TEMPERATURE=0.7
FISH_TOP_P=0.7
FISH_TIMEOUT_SECONDS=180

# Optional reference ID is not a secret, but keep it outside versioned jobs so
# a voice change is explicit at deployment time.
FISH_REFERENCE_ID=
