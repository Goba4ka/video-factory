[Unit]
Description=Create a consistent Video Factory state backup
After=local-fs.target

[Service]
Type=oneshot
User=video-factory-backup
Group=video-factory-backup
SupplementaryGroups=video-factory
UMask=0077
EnvironmentFile=/etc/video-factory/runtime.env
ExecStart=/opt/video-factory/current/factory/tools/backup_server_state.sh /srv/video-factory/backups
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/video-factory /srv/video-factory/artifacts
ReadWritePaths=/srv/video-factory/backups
