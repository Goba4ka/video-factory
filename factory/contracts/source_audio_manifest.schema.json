{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.video-factory/contracts/source_audio_manifest.schema.json",
  "title": "SourceAudioManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "lane",
    "audio_asset_id",
    "source_video_uri_or_path",
    "source_in_seconds",
    "source_out_seconds",
    "speaker_name",
    "transcript",
    "rights_status",
    "rights_evidence",
    "original_audio_only",
    "tts",
    "extracted_audio_path",
    "checksums",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "job_id": {"type": "string", "minLength": 6, "maxLength": 128},
    "lane": {"const": "motivation"},
    "audio_asset_id": {"type": "string", "minLength": 3, "maxLength": 128},
    "source_video_uri_or_path": {"type": "string", "minLength": 1, "maxLength": 4096},
    "source_in_seconds": {"type": "number", "minimum": 0},
    "source_out_seconds": {"type": "number", "exclusiveMinimum": 0},
    "speaker_name": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
    "transcript": {"type": "string", "minLength": 1, "maxLength": 12000},
    "rights_status": {
      "enum": ["consent_confirmed", "commercial_license_confirmed", "internal_prototype"]
    },
    "rights_evidence": {"type": ["string", "null"], "maxLength": 4096},
    "original_audio_only": {"const": true},
    "tts": {"const": false},
    "extracted_audio_path": {"type": "string", "minLength": 1, "maxLength": 4096},
    "checksums": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_video_sha256", "extracted_audio_sha256", "transcript_sha256"],
      "properties": {
        "source_video_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "extracted_audio_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "transcript_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "created_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"rights_status": {"const": "internal_prototype"}}},
      "then": {"properties": {"rights_evidence": {"type": ["string", "null"]}}},
      "else": {"properties": {"rights_evidence": {"type": "string", "minLength": 1}}}
    }
  ]
}
