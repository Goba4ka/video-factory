{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.video-factory/contracts/rights_manifest.schema.json",
  "title": "RightsManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "idea_id", "assets", "decision"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "idea_id": {"type": "string", "minLength": 6},
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_id",
          "landing_url",
          "creator",
          "license",
          "license_url",
          "retrieved_at",
          "commercial_use",
          "modification_allowed",
          "attribution_required",
          "platforms",
          "rights_status"
        ],
        "properties": {
          "asset_id": {"type": "string", "minLength": 3},
          "local_path": {"type": ["string", "null"]},
          "landing_url": {"type": "string", "format": "uri"},
          "download_url": {"type": ["string", "null"], "format": "uri"},
          "creator": {"type": "string", "minLength": 1},
          "license": {"type": "string", "minLength": 2},
          "license_url": {"type": "string", "format": "uri"},
          "license_receipt": {"type": ["string", "null"]},
          "retrieved_at": {"type": "string", "format": "date-time"},
          "commercial_use": {"type": "boolean"},
          "modification_allowed": {"type": "boolean"},
          "attribution_required": {"type": "boolean"},
          "attribution_text": {"type": ["string", "null"]},
          "model_release": {"enum": ["not_applicable", "confirmed", "unknown", "required"]},
          "property_release": {"enum": ["not_applicable", "confirmed", "unknown", "required"]},
          "platforms": {
            "type": "array",
            "items": {"enum": ["youtube_shorts", "instagram_reels", "tiktok"]},
            "minItems": 1,
            "uniqueItems": true
          },
          "territories": {"type": "array", "items": {"type": "string"}},
          "expires_at": {"type": ["string", "null"], "format": "date-time"},
          "rights_status": {"enum": ["approved", "human_review", "rejected"]},
          "notes": {"type": "string"}
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "needs_human_review", "missing_asset_ids", "review_notes"],
      "properties": {
        "passed": {"type": "boolean"},
        "needs_human_review": {"type": "boolean"},
        "missing_asset_ids": {"type": "array", "items": {"type": "string"}},
        "review_notes": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
