{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.video-factory/contracts/claim_ledger.schema.json",
  "title": "ClaimLedger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "idea_id", "sources", "claims", "decision"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "idea_id": {"type": "string", "minLength": 6},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "url", "publisher", "retrieved_at", "primary"],
        "properties": {
          "source_id": {"type": "string", "minLength": 3},
          "url": {"type": "string", "format": "uri"},
          "publisher": {"type": "string", "minLength": 2},
          "retrieved_at": {"type": "string", "format": "date-time"},
          "primary": {"type": "boolean"},
          "archived_receipt": {"type": ["string", "null"]},
          "notes": {"type": "string"}
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "text", "source_ids", "support", "risk"],
        "properties": {
          "claim_id": {"type": "string", "minLength": 3},
          "text": {"type": "string", "minLength": 5},
          "source_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
          "support": {"enum": ["direct", "inference", "disputed", "unsupported"]},
          "risk": {"enum": ["green", "yellow", "red"]},
          "script_usage": {"enum": ["allowed", "qualify", "omit"]},
          "notes": {"type": "string"}
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "needs_human_review", "review_notes"],
      "properties": {
        "passed": {"type": "boolean"},
        "needs_human_review": {"type": "boolean"},
        "review_notes": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
