{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.video-factory/contracts/shotlist.schema.json",
  "title": "ShotList",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "idea_id", "duration_seconds", "aspect", "shots"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "idea_id": {"type": "string", "minLength": 6},
    "duration_seconds": {"type": "number", "minimum": 15, "maximum": 180},
    "aspect": {"const": "9:16"},
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["shot_id", "start", "end", "narration", "visual_intent", "asset_id", "claim_ids"],
        "properties": {
          "shot_id": {"type": "string", "minLength": 3},
          "start": {"type": "number", "minimum": 0},
          "end": {"type": "number", "exclusiveMinimum": 0},
          "narration": {"type": "string"},
          "caption": {"type": "string"},
          "visual_intent": {"type": "string", "minLength": 3},
          "asset_id": {"type": "string", "minLength": 3},
          "source_in": {"type": "number", "minimum": 0},
          "source_out": {"type": "number", "minimum": 0},
          "claim_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "transition": {"enum": ["hard_cut", "crossfade", "dip_to_black", "custom"]}
        }
      }
    }
  }
}
