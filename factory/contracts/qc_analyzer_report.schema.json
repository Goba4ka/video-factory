{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.video-factory/contracts/qc_analyzer_report.schema.json",
  "title": "QCAnalyzerReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "category", "job_id", "lane_id", "render_id",
    "render_sha256", "status", "needs_human_review", "warnings", "findings",
    "checker", "completed_at", "bindings", "metrics"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "category": {
      "enum": ["technical", "audio", "captions", "facts", "rights", "dedup", "policy", "visual"]
    },
    "job_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "lane_id": {
      "enum": ["war_history", "celebrity_news", "motivation", "chinese_medicine", "health"]
    },
    "render_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "render_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "status": {"enum": ["pass", "warn", "fail", "not_run"]},
    "needs_human_review": {"type": "boolean"},
    "warnings": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "findings": {"type": "array", "items": {}},
    "checker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "run_id"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "run_id": {"type": "string", "minLength": 1}
      }
    },
    "completed_at": {"type": "string", "format": "date-time"},
    "bindings": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    },
    "metrics": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "pass"}}},
      "then": {
        "properties": {
          "needs_human_review": {"const": false},
          "warnings": {"maxItems": 0},
          "findings": {"maxItems": 0}
        }
      }
    }
  ]
}
